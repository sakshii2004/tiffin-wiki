generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

// The following four enums document the allowed values for their respective
// String[] columns on TiffinService. They are intentionally NOT used as column
// types (Prisma cannot type a Postgres array with a Prisma enum); the
// application layer and the Zod schemas in lib/validations.ts enforce these
// exact values.
enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum OperationalDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// These two enums ARE used directly as scalar column types.
enum ContainerType {
  STEEL
  DISPOSABLE
}

enum SpiceLevel {
  MILD
  MEDIUM
  SPICY
}

// ─── Core models ──────────────────────────────────────────────────────────────

model TiffinService {
  id                 String         @id @default(cuid())
  slug               String         @unique
  name               String
  city               String
  area               String?
  whatsappNumber     String
  deliveryAreas      String[]
  // String[] columns hold enum values serialised as strings — see the MealType
  // and OperationalDay enums above for allowed values.
  mealsOffered       String[]
  isVegetarian       Boolean        @default(true)
  hasNonVeg          Boolean        @default(false)
  containerType      ContainerType?
  requiresTiffinWash Boolean?
  spiceLevel         SpiceLevel?
  operationalDays    String[]
  description        String?
  status             ListingStatus  @default(PENDING)
  // Hashed submitter IP — stored for abuse detection, never exposed publicly.
  submitterIp        String?
  // Internal notes — never returned to the public API.
  submitterNote      String?
  adminNote          String?
  // Future-scope: owner-claim flow
  isOwnerClaimed     Boolean        @default(false)
  ownerId            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  images    ServiceImage[]
  reviews   Review[]
  offerings TiffinOffering[]

  @@index([city])
  @@index([status])
  @@index([city, status])
  @@index([createdAt])
}

model TiffinOffering {
  id             String   @id @default(cuid())
  serviceId      String
  sizeName       String
  mealComponents String[]
  pricePerMeal   Int?
  pricePerMonth  Int?
  searchPricePerMeal   Int?
  searchPricePerMonth  Int?
  sortOrder      Int      @default(0)

  service TiffinService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
}

model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  r2Key     String
  publicUrl String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  service TiffinService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
}

model Review {
  id        String   @id @default(cuid())
  serviceId String
  userId    String
  rating    Int
  body      String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service TiffinService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images  ReviewImage[]

  @@unique([serviceId, userId])
  @@index([serviceId])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  r2Key     String
  publicUrl String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

// ─── NextAuth.js v5 models ────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  reviews  Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Rate limiting ────────────────────────────────────────────────────────────

model SubmissionRateLimit {
  id        String   @id @default(cuid())
  ipHash    String
  date      String   // YYYY-MM-DD
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ipHash, date])
}

// ─── Telemetry & Analytics ───────────────────────────────────────────────────

model TelemetryEvent {
  id           String   @id @default(cuid())
  sessionId    String   // Anonymous browser session UUID
  eventType    String   // PAGE_VIEW, TIME_SPENT, SEARCH_EXECUTE, WHATSAPP_REVEAL, etc.
  pathname     String   // Target route
  
  // Dynamic payload attributes
  searchQuery  String?
  city         String?
  listingId    String?
  listingSlug  String?
  ctaName      String?
  filterName   String?
  filterValue  String?
  durationSec  Int?
  rating       Int?
  
  // Device & Network Metadata
  deviceType   String?  // "mobile" | "desktop" | "tablet"
  ipHash       String?  // Hashed client IP
  country      String?  // Geolocation country
  geoCity      String?  // Geolocation city
  referrer     String?
  createdAt    DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([pathname, createdAt])
  @@index([listingId, eventType])
  @@index([sessionId])
}
